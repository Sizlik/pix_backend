APP_ENV=local

# Local PostgreSQL (used by local-docker-compose.yml and FastAPI)
POSTGRES_DRIVER=postgresql+asyncpg
POSTGRES_USER=pix
POSTGRES_PASSWORD=pix_local
POSTGRES_DB=pix
POSTGRES_HOST=localhost
DB_PORT=5431

# Local Redis and authentication defaults
REDIS_URL=redis://localhost:6379/0
TOKEN_LIFETIME=3600
VERIFICATION_TOKEN_SECRET=local-verification-secret
RESET_PASSWORD_TOKEN_SECRET=local-reset-secret
CORS_ORIGINS=["http://localhost:3000"]
ENABLE_SCHEDULER=false

# Optional external integrations. Leave empty for offline local development.
BOT_TOKEN=
CHAT_ID=
HELP_CHAT_ID=
BITRIX_LINK=
MOYSKLAD_LOGIN=
MOYSKLAD_PASSWORD=
PRIVOZ_USERNAME=
PRIVOZ_PASSWORD=
MAILERSEND_TOKEN=
