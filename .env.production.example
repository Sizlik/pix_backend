# Merge missing keys into the existing server .env. Do not replace that file.
# Fill blank values only in the production secret store or ignored server .env.

# Application and PostgreSQL
APP_ENV=production
POSTGRES_DRIVER=postgresql+asyncpg
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
DB_PORT=5431

# Redis, authentication, browser access, and scheduler
REDIS_URL=redis://localhost:6379/0
TOKEN_LIFETIME=3600
VERIFICATION_TOKEN_SECRET=
RESET_PASSWORD_TOKEN_SECRET=
CORS_ORIGINS=["https://pixlogistic.com"]
ENABLE_SCHEDULER=false
TELEGRAM_NOTIFICATION_TIMEOUT_SECONDS=3

# Existing integrations
BOT_TOKEN=
CHAT_ID=
HELP_CHAT_ID=
BITRIX_LINK=
MOYSKLAD_LOGIN=
MOYSKLAD_PASSWORD=
PRIVOZ_USERNAME=
PRIVOZ_PASSWORD=
MAILERSEND_TOKEN=

# MoySklad order chat. Keep disabled through the initial deployment.
ENABLE_MOYSKLAD_ORDER_CHAT=false
MOYSKLAD_ORDER_CHAT_WEBHOOK_SECRET=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=pix-order-chat
MINIO_SECURE=false
CHAT_ATTACHMENT_MAX_BYTES=20971520
CHAT_ATTACHMENT_MAX_COUNT=10
CHAT_OUTBOX_MAX_ATTEMPTS=8
CHAT_OUTBOX_BASE_DELAY_SECONDS=5

# Public frontend build input. Never put a credential in NEXT_PUBLIC_*.
NEXT_PUBLIC_BACKEND_URL=https://pixlogistic.com/api_v1

# Existing production Compose administration service
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
